<Window x:Class="WindowsPersonalize.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS Desktop — Windows Personalize" Width="1450" Height="900" MinWidth="1100" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#050713" Foreground="#F4F1FF">
<Window.Resources>
 <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#E7E1FF"/><Setter Property="Background" Value="#11102A"/><Setter Property="BorderBrush" Value="#553D4C91"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,4"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="TileButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#B20A1028"/><Setter Property="BorderBrush" Value="#773B4F9B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#692A0D70"/><Setter Property="BorderBrush" Value="#B34CDEFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#D9080C20"/><Setter Property="BorderBrush" Value="#664C5AA7"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="5"/></Style>
</Window.Resources>
<Grid>
 <Grid.Background><RadialGradientBrush><GradientStop Color="#35105C" Offset="0"/><GradientStop Color="#10123A" Offset="0.48"/><GradientStop Color="#030611" Offset="1"/></RadialGradientBrush></Grid.Background>
 <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="56"/></Grid.RowDefinitions>
 <Border Grid.Row="0" Background="#D9040715" BorderBrush="#663E4D91" BorderThickness="0,0,0,1"><DockPanel Margin="18,0"><TextBlock Text="N  N E X U S" Foreground="#62D8FF" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock x:Name="ClockText" Text="NEXUS DESKTOP" Foreground="#BDA5FF" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel></Border>
 <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,5,8,5"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="NEXUS" Foreground="#C56BFF" FontSize="29" FontWeight="Bold" Margin="5,8,0,0"/><TextBlock Text="DESKTOP FUTURISTA" Foreground="#71D9FF" FontSize="10" Margin="7,0,0,16"/></StackPanel><StackPanel>
   <Button Style="{StaticResource NavButton}" Content="⌂   INICIO" Click="ShowHome"/><Button Style="{StaticResource NavButton}" Content="▦   APLICACIONES" Click="AddApp"/><Button Style="{StaticResource NavButton}" Content="🎮   JUEGOS" Click="AddApp"/><Button Style="{StaticResource NavButton}" Content="⚙   SISTEMA" Click="OpenSystem"/><Button Style="{StaticResource NavButton}" Content="✎   PERSONALIZACIÓN" Click="Personalize"/><Button Style="{StaticResource NavButton}" Content="☷   AJUSTES" Click="OpenSettings"/><Button Style="{StaticResource NavButton}" Content="▱   ARCHIVOS" Click="OpenFiles"/>
   </StackPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0"><Separator Background="#55547B"/><Button Style="{StaticResource ActionButton}" Content="↶  VOLVER A WINDOWS" Click="ReturnToWindows" Margin="0,14,0,4"/><TextBlock Text="Cierra NEXUS y vuelve al escritorio normal de Windows." TextWrapping="Wrap" Foreground="#A9A5C7" FontSize="10" Margin="4"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="4,5,4,5"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="SearchBox" Grid.Row="0" Height="38" VerticalContentAlignment="Center" FontSize="14" Background="#B8090C20" Foreground="White" BorderBrush="#884B4D9A" Padding="12" Text="Buscar aplicaciones o ajustes..." GotFocus="SearchFocus" TextChanged="SearchChanged"/>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,8"><DockPanel><TextBlock DockPanel.Dock="Top" Text="APLICACIONES   ·   FAVORITAS   ·   RECIENTES" Foreground="#D7B9FF" FontSize="13" Margin="8,4,0,14"/><ScrollViewer VerticalScrollBarVisibility="Auto"><UniformGrid x:Name="AppGrid" Columns="5"/></ScrollViewer></DockPanel></Border>
   <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><StackPanel><TextBlock Text="PERSONALIZACIÓN RÁPIDA" Foreground="#DCA9FF" FontWeight="SemiBold" Margin="2,0,0,6"/><WrapPanel><Button Style="{StaticResource ActionButton}" Content="▧  FONDO" Click="ChooseWallpaper"/><Button Style="{StaticResource ActionButton}" Content="◉  TEMAS" Click="ToggleTheme"/><Button Style="{StaticResource ActionButton}" Content="▣  ICONOS" Click="AddApp"/><Button Style="{StaticResource ActionButton}" Content="▤  BARRA DE TAREAS" Click="OpenTaskbar"/><Button Style="{StaticResource ActionButton}" Content="✧  EFECTOS" Click="ToggleEffects"/></WrapPanel><TextBlock Text="PERFILES DE RENDIMIENTO" Foreground="#DCA9FF" Margin="2,8,0,5"/><WrapPanel><Button Style="{StaticResource ActionButton}" Content="🎮 MODO JUEGO" Click="GamingMode"/><Button Style="{StaticResource ActionButton}" Content="◉ MODO NORMAL" Click="NormalMode"/><Button Style="{StaticResource ActionButton}" Content="▣ MODO TRABAJO" Click="WorkMode"/><Button Style="{StaticResource ActionButton}" Content="♧ MODO AHORRO" Click="EcoMode"/></WrapPanel></StackPanel></Border>
  </Grid>
  <StackPanel Grid.Column="2" Margin="7,5,0,5">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RENDIMIENTO DEL SISTEMA" Foreground="#DCA9FF" FontSize="13"/><TextBlock x:Name="CpuText" Text="CPU: consultando..." FontSize="17" Margin="0,10,0,2"/><ProgressBar x:Name="CpuBar" Height="9" Maximum="100" Foreground="#B44CFF"/><TextBlock x:Name="RamText" Text="RAM: consultando..." FontSize="17" Margin="0,12,0,2"/><ProgressBar x:Name="RamBar" Height="9" Maximum="100" Foreground="#19B9FF"/><TextBlock x:Name="DiskText" Text="ALMACENAMIENTO" Foreground="#BDA5FF" Margin="0,12,0,0"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MODO ACTIVO" Foreground="#DCA9FF"/><TextBlock x:Name="ModeText" Text="MODO NORMAL" FontSize="20" Margin="0,8"/><TextBlock Text="Los perfiles modifican las preferencias de energía disponibles en Windows." Foreground="#AAA7C5" TextWrapping="Wrap" FontSize="11"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ESTADO DEL SISTEMA" Foreground="#DCA9FF"/><TextBlock Text="Windows Personalize 1.4.0" Margin="0,10,0,4"/><TextBlock Text="Arquitectura Windows x64" Foreground="#AAA7C5"/><TextBlock x:Name="StatusText" Text="Listo" Foreground="#65D9FF" Margin="0,7"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HERRAMIENTAS DEL SISTEMA" Foreground="#DCA9FF"/><WrapPanel><Button Style="{StaticResource ActionButton}" Content="LIMPIEZA" Click="CleanTemp"/><Button Style="{StaticResource ActionButton}" Content="INICIO" Click="StartupToggle"/><Button Style="{StaticResource ActionButton}" Content="RESTAURAR" Click="Restore"/><Button Style="{StaticResource ActionButton}" Content="ACTUALIZAR" Click="Updates"/></WrapPanel></StackPanel></Border>
  </StackPanel>
 </Grid>
 <Border Grid.Row="2" Background="#B9070A1C" BorderBrush="#553F4C8C" BorderThickness="0,1,0,0"><DockPanel LastChildFill="True" Margin="20,0"><TextBlock Text="NEXUS  •  PERSONALIZA TU EXPERIENCIA" Foreground="#9F9AC4" VerticalAlignment="Center"/><TextBlock Text="ESC  ·  VOLVER A WINDOWS" Foreground="#B9A0FF" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel></Border>
</Grid></Window>